# =====================================================
# IP-SAKTI SAHAYAK — Environment Configuration Example
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# =====================================================

# ---- Required ----
GROQ_API_KEY=your_groq_api_key_here

# ---- LLM / AI models ----
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
EMBEDDING_DIMENSION=1024

# ---- Retrieval tuning ----
HYBRID_SEMANTIC_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# ---- Confidence thresholds ----
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.60
CONFIDENCE_LOW=0.40
ABSTENTION_THRESHOLD=0.40

# ---- Database ----
DATABASE_URL=sqlite:///ip_sakti.db

# ---- Paths (override only if you need non-default locations) ----
VECTOR_DB_PATH=data/index/faiss.index
BM25_INDEX_PATH=data/index/bm25.pkl
CACHE_PATH=data/cache

# ---- Cache ----
CACHE_DEFAULT_TTL_HOURS=168

# ---- Language ----
SUPPORTED_LANGUAGES=en,hi,or
DEFAULT_LANGUAGE=en

# ---- Networking / uploads ----
REQUEST_TIMEOUT_SECONDS=15
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,docx

# ---- Flask ----
SECRET_KEY=change-me-to-a-random-value
DEBUG=False
HOST=0.0.0.0
PORT=5000
